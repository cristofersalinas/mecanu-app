{
  "name": "mecanu-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-puertos.mjs dev",
    "demo": "node scripts/dev-puertos.mjs demo",
    "stop": "node scripts/dev-puertos.mjs stop",
    "entorno": "node scripts/entorno.mjs",
    "slack:bootstrap": "node scripts/slack-bootstrap.mjs",
    "csx:semanal": "npx --yes tsx scripts/csx-semanal.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "copy:maplibre": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "slack:sync-token": "node scripts/slack-sync-token.mjs",
    "db:migrate": "node scripts/aplicar-migraciones.mjs",
    "db:invitar": "node scripts/invitar-usuario.mjs",
    "db:seed": "node scripts/seed-demo-taller.mjs",
    "db:seed:full": "npx tsx scripts/seed-mock-full.ts",
    "db:seed:avance": "node scripts/seed-escenario-avance.mjs",
    "db:bootstrap": "node scripts/bootstrap-demo-taller.mjs",
    "wa:bridge": "node --experimental-strip-types scripts/whatsapp-sesion-bridge.ts",
    "video": "npm --prefix video run dev"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "baileys": "^7.0.0-rc14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^176.0.0",
    "maplibre-gl": "^6.4.1",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
