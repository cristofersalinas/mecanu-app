{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/desktop/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/mobile/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Attachment'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|type|status|progress|onRemove|onRetry|style|key|ref|className|style|children)$/]",
        "message": "<Attachment> doesn't accept that prop. Declared props: name, meta, type, status, progress, onRemove, onRetry, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Attachment'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:image|pdf|doc)$/]",
        "message": "<Attachment> type must be one of 'image' | 'pdf' | 'doc'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Attachment'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:uploading|done|error)$/]",
        "message": "<Attachment> status must be one of 'uploading' | 'done' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|square|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, square, style."
      },
