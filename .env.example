# Copy this file to `.env.local` for local development and fill in real
# values. Never commit `.env.local` — it is (and must stay) git-ignored.
#
# In Vercel, set these under Project Settings -> Environment Variables
# instead of committing them anywhere.

# --- Supabase --------------------------------------------------------------

# Your Supabase project's API URL. Find it in the Supabase dashboard:
# Project Settings -> API -> Project URL.
# Safe to expose to the browser (that's what NEXT_PUBLIC_ means in Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The Supabase "anon" / public API key. Find it next to the URL above:
# Project Settings -> API -> Project API keys -> anon / public.
# Safe to expose to the browser: it can only do what Row Level Security
# (RLS) policies in the database allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Supabase "service_role" key. Find it next to the anon key:
# Project Settings -> API -> Project API keys -> service_role.
# WARNING: this key bypasses Row Level Security and has full read/write
# access to the entire database. Server-only. Must NEVER be prefixed
# NEXT_PUBLIC_, must NEVER be committed, and must NEVER be referenced from
# a client component — only from server-side code (Server Actions, Route
# Handlers, etc).
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry (error tracking) ------------------------------------------------

# The Sentry DSN (Data Source Name) tells the SDK where to send errors.
# Find it in Sentry: Settings -> Projects -> [your project] -> Client Keys
# (DSN). Leave both blank locally and Sentry stays silent (no network
# calls, nothing sent anywhere) — no other configuration is required to
# keep it off.
# Server-side/build-time DSN (used by src/instrumentation.ts).
SENTRY_DSN=
# Same DSN, exposed to the browser for client-side error capture (used by
# src/instrumentation-client.ts). A Sentry DSN is a write-only endpoint
# identifier, not a secret, so it's safe to expose with NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=

# Only needed in CI/build environments that upload source maps to Sentry
# (so stack traces show your real source code, not minified bundles).
# Find/create it in Sentry: Settings -> Auth Tokens. Server/CI-only —
# never exposed to the browser, never committed.
SENTRY_AUTH_TOKEN=

# Optional, only used alongside SENTRY_AUTH_TOKEN for source map uploads.
# Find them in your Sentry project URL or Settings -> General Settings.
SENTRY_ORG=
SENTRY_PROJECT=

# --- Public surfaces ----------------------------------------------------------

# In any Vercel deploy (production AND preview) only the landing is served:
# `/panel`, `/conductor` and `/api/v1/*` are cut off by `src/proxy.ts`.
# Local `next dev` / `next start` still serve all three — VERCEL is unset.
#
# Set this to 1 on a specific Vercel environment if you need the panel on a
# preview (for example, to click through staging). Do not set it on Production
# until those apps are meant to be public.
MECANU_EXPONER_APPS=

# --- Analytics (public landing only) ----------------------------------------

# Google Tag Manager container. Loaded once, only after the visitor accepts
# analytics cookies. Not used on /panel or /conductor. Do not also paste a
# standalone gtag.js snippet: GA4 should fire from this container.
NEXT_PUBLIC_GTM_ID=GTM-T8TJGTJQ

# GA4 measurement ID. Documented here so it is obvious which property GTM
# should send to. This repo does not inject gtag.js for it.
NEXT_PUBLIC_GA4_ID=G-MRS0P42Z2L

# Microsoft Clarity project. Loaded once, after consent, as its own snippet.
# Do not also add a Clarity tag inside GTM: that would record twice.
NEXT_PUBLIC_CLARITY_ID=y4kpmlt67l

# GTM only runs when Vercel reports production, unless this is set to 1
# (local check of the consent gate). Do not set it in Vercel Production.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# --- Google Maps (Street View en el mapa de talleres) ------------------------

# API Key de Google Maps Platform con la API "Street View Static API" habilitada.
# Pasos:
#   1. console.cloud.google.com -> APIs & Services -> Enable APIs
#   2. Busca "Street View Static API" y habilítala
#   3. Credentials -> Create Credentials -> API Key
#   4. Restricciones recomendadas: HTTP referrers: mecanu.com/* y localhost:3000/*
# Costo: ~0,007 USD/imagen. Hay 200 USD/mes de crédito gratuito.
# Segura para exponer al navegador (solo genera imágenes estáticas).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Formulario de captación de talleres (#contacto) -------------------------

# ID de la Google Sheet donde se guardan las respuestas del formulario.
# Es la parte de la URL entre /d/ y /edit. Por ejemplo:
# https://docs.google.com/spreadsheets/d/1KwAwK8JmE48O4CCGZfGMmgGRP0oA2jQtWU-6v5sYOIM/...
#                                         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
GOOGLE_SHEETS_ID=1KwAwK8JmE48O4CCGZfGMmgGRP0oA2jQtWU-6v5sYOIM

# Credenciales JSON de una Service Account de Google Cloud con permisos de
# escritura sobre la sheet anterior. Pasos:
#   1. Google Cloud Console -> IAM -> Service Accounts -> Crear cuenta
#   2. Crear clave JSON y copiar el contenido completo (una sola línea)
#   3. Compartir la sheet con el email de la Service Account (editor)
# Server-only. NUNCA con prefijo NEXT_PUBLIC_. NUNCA en git.
GOOGLE_SERVICE_ACCOUNT_JSON=

# API Key de Resend (https://resend.com) para enviar el email de notificación
# a cris@mecanu.com. Plan gratuito: 3.000 emails/mes, 100/día.
# Obtener en: resend.com -> API Keys -> Create API Key.
# Server-only. NUNCA con prefijo NEXT_PUBLIC_. NUNCA en git.
RESEND_API_KEY=

# --- Funnel ITV a domicilio (automovilistas) --------------------------------
# Número de WhatsApp en formato internacional, solo dígitos. Ejemplo España:
# 34600111222  →  https://wa.me/34600111222
NEXT_PUBLIC_ITV_WHATSAPP=
# Precio público opcional, tal cual se muestra. Ej: "89 €" o "desde 79 € + tasa".
# Si está vacío, la landing no muestra cifra y cierra el precio por WhatsApp.
NEXT_PUBLIC_ITV_PRECIO=

# --- Next.js -----------------------------------------------------------------

# Next.js sets this automatically (development / production / test).
# Listed here only for documentation completeness — you should not need
# to set this yourself.
NODE_ENV=
