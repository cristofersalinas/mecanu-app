# Copy this file to `.env.local` for local development and fill in real
# values. Never commit `.env.local` — it is (and must stay) git-ignored.
#
# In Vercel, set these under Project Settings -> Environment Variables
# instead of committing them anywhere.

# --- Supabase --------------------------------------------------------------

# Your Supabase project's API URL. Find it in the Supabase dashboard:
# Project Settings -> API -> Project URL.
# Safe to expose to the browser (that's what NEXT_PUBLIC_ means in Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The Supabase "anon" / public API key. Find it next to the URL above:
# Project Settings -> API -> Project API keys -> anon / public.
# Safe to expose to the browser: it can only do what Row Level Security
# (RLS) policies in the database allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Supabase "service_role" key. Find it next to the anon key:
# Project Settings -> API -> Project API keys -> service_role.
# WARNING: this key bypasses Row Level Security and has full read/write
# access to the entire database. Server-only. Must NEVER be prefixed
# NEXT_PUBLIC_, must NEVER be committed, and must NEVER be referenced from
# a client component — only from server-side code (Server Actions, Route
# Handlers, etc).
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry (error tracking) ------------------------------------------------

# The Sentry DSN (Data Source Name) tells the SDK where to send errors.
# Find it in Sentry: Settings -> Projects -> [your project] -> Client Keys
# (DSN). Leave both blank locally and Sentry stays silent (no network
# calls, nothing sent anywhere) — no other configuration is required to
# keep it off.
# Server-side/build-time DSN (used by src/instrumentation.ts).
SENTRY_DSN=
# Same DSN, exposed to the browser for client-side error capture (used by
# src/instrumentation-client.ts). A Sentry DSN is a write-only endpoint
# identifier, not a secret, so it's safe to expose with NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=

# Only needed in CI/build environments that upload source maps to Sentry
# (so stack traces show your real source code, not minified bundles).
# Find/create it in Sentry: Settings -> Auth Tokens. Server/CI-only —
# never exposed to the browser, never committed.
SENTRY_AUTH_TOKEN=

# Optional, only used alongside SENTRY_AUTH_TOKEN for source map uploads.
# Find them in your Sentry project URL or Settings -> General Settings.
SENTRY_ORG=
SENTRY_PROJECT=

# --- Superficies públicas -----------------------------------------------------

# En producción solo se sirve la landing (`/`). `/panel`, `/conductor` y
# `/api/v1/*` quedan cortados por `src/middleware.ts` porque todavía funcionan
# con datos mock. En local y en los previews de Vercel siguen accesibles sin
# tocar nada: no hace falta definir esta variable para desarrollar.
#
# Ponla a 1 en Vercel (entorno Production) el día que quieras abrir el panel y
# el conductor al público.
MECANU_EXPONER_APPS=

# --- Next.js -----------------------------------------------------------------

# Next.js sets this automatically (development / production / test).
# Listed here only for documentation completeness — you should not need
# to set this yourself.
NODE_ENV=
